# ---- Slack credentials -------------------------------------------------------
# Bot User OAuth Token — Slack app → OAuth & Permissions (starts with xoxb-)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-Level Token with the connections:write scope — Basic Information →
# App-Level Tokens. Required for socket mode (starts with xapp-)
SLACK_APP_TOKEN=xapp-your-app-token

# ---- Channels ----------------------------------------------------------------
# Channel pairings are NOT configured here any more. Run `/relay setup` in
# Slack: it opens a form with two channel pickers, and you can add as many
# client → team pairings as you have clients.
#
# The two settings below are a one-time bootstrap for upgrading an older
# install: on first run they're copied into the database and then ignored. New
# installs should leave them empty.
INTERNAL_CHANNEL=
CLIENT_CHANNELS=
# Ingest mode is per-pairing now, chosen in the /relay setup form.
INGEST_MODE=all

# Reaction that claims a request and assigns it to whoever reacted.
# Slack reports the same glyph under different names depending on which client
# added it (✋ arrives as either `raised_hand` or `hand`), so known aliases are
# accepted automatically — you do not need to list them. Comma-separated values
# are additive if you want unrelated emoji to work too.
CLAIM_EMOJI=raised_hand

# Reaction that dismisses a request without creating a task.
DISMISS_EMOJI=x

# Dropped on the client's message to show it was received. Set to `none` to
# leave client messages untouched.
ACK_EMOJI=eyes

# Prefix for in-thread commands, e.g. !start
COMMAND_PREFIX=!

# ---- Editor API (Claude Code / Codex) ----------------------------------------
# The HTTP surface the `relay` CLI and the skill talk to.
API_ENABLED=true
API_PORT=3737

# Defaults to loopback. Binding to anything else (0.0.0.0, a LAN address, a
# Tailscale IP) automatically REQUIRES token auth — mint tokens with
# `npm run token -- --user U0123ABCD`. On loopback with no tokens minted, calls
# are unauthenticated and identify themselves with RELAY_USER.
API_HOST=127.0.0.1

# ---- Work sessions -----------------------------------------------------------
# A session with no heartbeat for this long is closed automatically, backdated
# to its last heartbeat. This is what stops a closed laptop from billing
# overnight. Lower = tighter accounting, more false pauses during long thinking.
SESSION_STALE_MINUTES=20
SESSION_REAP_INTERVAL_MINUTES=5

# Only used to phrase long durations to the client as "about 2 days of work".
HOURS_PER_DAY=6

# ---- Google (operator credentials, set ONCE by whoever runs Relay) ------------
# Workspaces connect their own Google account by clicking Allow. They never need
# a Google Cloud project — you register Relay once and these identify it.
#
#   console.cloud.google.com → APIs & Services → Credentials
#   → Create credentials → OAuth client ID → Web application
#   → Authorised redirect URI:  <PUBLIC_URL>/oauth/google/callback
#
# Relay asks only for the `drive.file` scope, which covers files it created.
# That is intentional: the broader `spreadsheets` scope is classified sensitive
# by Google and would require a verification review before external launch.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends people back after they click Allow. Must be public HTTPS.
PUBLIC_URL=

# ---- Google Sheets mirror (legacy single-tenant path) -------------------------
# Mirrors the ledger into a spreadsheet so people who don't live in Slack can
# see the work. ONE WAY: SQLite stays authoritative and edits made in the sheet
# are overwritten on the next sync.
#
# The LINK is set from Slack — `/relay setup` → Connect sheet, or
# `/relay sheet <url>`. Only the credentials belong here, because they're a
# secret rather than a preference.
#
# SHEETS_ID is an optional default for a fresh install; anything set from Slack
# takes precedence.
SHEETS_ID=

# Path to a Google service account JSON key with the Sheets API enabled. Share
# the spreadsheet with that key's client_email address as an Editor, or writes
# will fail with a permission error.
GOOGLE_SERVICE_ACCOUNT_FILE=

# Alternatively paste the JSON itself (handy for container secrets):
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"..."}

# How often to check for changes. Nothing is sent when nothing has changed.
SHEETS_SYNC_SECONDS=120

# ---- Runtime -----------------------------------------------------------------
DB_PATH=./relay.db
LOG_LEVEL=info

# Logs one line per inbound Slack event, whatever the log level. Turn on when
# something "does nothing" — it separates an event that never arrived from one
# that arrived and was ignored.
LOG_EVENTS=false

# ---- Coolify deployment helper (optional) -----------------------------------
# These values drive `npm run coolify <probe|create|env|deploy|status>` for the
# long-lived Relay BOT. The static product website in website/ is not deployed
# by this helper.
COOLIFY_URL=
COOLIFY_TOKEN=
COOLIFY_SERVER_UUID=
COOLIFY_PROJECT_UUID=
COOLIFY_ENVIRONMENT=production

# `npm run coolify create` prints this value after it creates the application.
COOLIFY_APP_UUID=
COOLIFY_APP_NAME=relay
COOLIFY_REPO=https://github.com/Kurama07a/relay
COOLIFY_BRANCH=main
